# Локальные секреты (не коммитить). Загружается через python-dotenv в config.py

# --- LM Studio ---
LM_STUDIO_API_KEY=ваш_апи_сюда
LM_STUDIO_API_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_CHAT_URL=http://localhost:1234/api/v1/chat
LM_STUDIO_MODEL=ваша_локальная_модель
LM_STUDIO_CONNECT_TIMEOUT=10
LM_STUDIO_TIMEOUT=120
LM_STUDIO_STREAM_TIMEOUT=300
TEXT_STREAMING=1
MCP_PLUGIN_ID=web-search
WEB_SEARCH_VIA_MCP=0
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_LANGUAGE=ru-RU
SEARXNG_MAX_RESULTS=8
SEARXNG_TIMEOUT=20
SEARXNG_MANAGE=1
SEARXNG_START_TIMEOUT=60
WEB_FETCH_MAX_PAGES=3
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_TIMEOUT=15

# --- Web UI ---
WEB_LOGIN_USERNAME=admin
WEB_LOGIN_PASSWORD=admin
CORELINE_WEB_HOST=0.0.0.0
CORELINE_WEB_PORT=5000
CORELINE_MAX_HISTORY=40

# --- Memory ---
CORELINE_USE_MEMORY=1
CORELINE_MEMORY_DIR=memory
CORELINE_INDEX_DEBOUNCE=2
MEMSEARCH_EMBEDDING_MODEL=ембединг_модель_для_работы_памяти
MEMSEARCH_OPENAI_BASE_URL=http://localhost:1234/v1

# --- Voice (RHVoice + Vosk) ---
RHVOICE_VOICE=anna
TTS_LANG=ru
RHVOICE_LIB_PATH=
RHVOICE_DATA_PATH=
RHVOICE_RESOURCE_PATH=
STT_ENGINE=vosk
VOSK_MODEL_PATH=
STT_GOOGLE_LANG=ru-RU
STT_SILENCE_TIMEOUT=3
STT_ENERGY_FACTOR=0.32
STT_SPEECH_DETECT_FACTOR=1.0
